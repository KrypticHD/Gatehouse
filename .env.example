# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local — only .env.example is tracked.

# --- Database -----------------------------------------------------------------
# Postgres connection string. Required before running `npm run db:migrate` or any
# route that touches the database. Prisma Migrate reads this via prisma.config.ts;
# the app reads it via src/server/env.ts / src/server/db/client.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/gatehouse?schema=public"

# --- Sessions --------------------------------------------------------------------
# Secret used to encrypt the session cookie (iron-session). Generate with:
#   openssl rand -base64 32
# Must be at least 32 characters.
SESSION_SECRET=""

# --- Public app config ----------------------------------------------------------
# Origin used to build the SIWE message's domain/uri fields. Must match where the
# app is actually served from.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default chain Gatehouse targets for local/staging development.
# 11155111 = Sepolia. Production network selection is intentionally unset — see
# docs/architecture.md.
NEXT_PUBLIC_DEFAULT_CHAIN_ID="11155111"

# --- Wallet connection -----------------------------------------------------------
# WalletConnect Cloud project ID, required by RainbowKit's connector list.
# https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# JSON-RPC URL for Sepolia, used for on-chain balance reads once eligibility
# checking is wired to a live provider (e.g. from Alchemy or Infura).
SEPOLIA_RPC_URL=""

# --- Pre-launch gate -------------------------------------------------------------
# Shared secret that unlocks the pre-launch app (everything under /app) via
# /preview?code=<this value>, which sets an HttpOnly cookie. The public "coming
# soon" landing page at / needs no code. Unset means /app is blocked outright —
# fail closed, not open. Generate with:
#   openssl rand -hex 16
PREVIEW_ACCESS_CODE=""

# The Gatehouse project's X (Twitter) profile URL, linked from the landing page
# nav. Leave blank to hide the link until one exists.
NEXT_PUBLIC_GATEHOUSE_X_URL=""
